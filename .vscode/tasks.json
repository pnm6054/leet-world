{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Kotlin: Build",
            "type": "shell",
            "command": "./gradlew",
            "windows": {
                "command": ".\\gradlew.bat"
            },
            "args": ["build", "--console=plain"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
